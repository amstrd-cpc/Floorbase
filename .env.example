# Application
NODE_ENV=development
APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/floorbase?schema=public

# Internal admin auth
AUTH_SESSION_SECRET=replace-with-a-strong-32-char-min-secret
AUTH_COOKIE_NAME=floorbase_session
AUTH_SESSION_TTL_HOURS=12
AUTH_INVITE_TTL_HOURS=72

# Stripe billing (required in production — get keys from dashboard.stripe.com)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...

# Local seed defaults
SEED_DEFAULT_PASSWORD=DevPassword123!
