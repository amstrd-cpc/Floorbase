generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  HOST
  STAFF
}

enum AdminRole {
  SUPER_ADMIN
  ORGANIZATION_ADMIN
  VENUE_MANAGER
  HOST
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  ASSIGN_TABLE
  NOTE_ADDED
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  INVITE_ACCEPTED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  INTERNAL
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

enum TableShape {
  SQUARE
  ROUND
  RECTANGLE
  BOOTH
  HIGH_TOP
  BAR
  COUNTER
  CUSTOM
}

enum TableType {
  STANDARD
  OUTDOOR
  BAR
  PRIVATE
  ACCESSIBLE
  FLEX
}

enum VenueBookingMode {
  AUTO_CONFIRM
  REQUEST_ONLY
}

enum VenuePlacementMode {
  AUTO_ASSIGN
  TABLE_SELECTION
}

enum BookingEventType {
  SINGLE_DATE
  WEEKLY_RECURRING
  DATE_RANGE
}

enum BookingLifecycleStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

enum FloorLayoutStatus {
  DRAFT
  PUBLISHED
}

model Organization {
  id                   String             @id @default(cuid())
  name                 String
  slug                 String             @unique
  isActive             Boolean            @default(true)
  onboardingComplete   Boolean            @default(false)
  trialEndsAt          DateTime?
  subscriptionStatus   SubscriptionStatus @default(TRIALING)
  stripeCustomerId     String?            @unique
  subscriptionId       String?            @unique
  planId               String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  venues              Venue[]
  guests              Guest[]
  reservationStatuses ReservationStatus[]
  reservations        Reservation[]
  memberships         Membership[]
  auditLogs           AuditLog[]
  users               User[]                @relation("OrganizationUsers")
  notifications       NotificationLog[]
  adminRoles          AdminRoleAssignment[]
  authInvites         AuthInvite[]
}

model Venue {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  country        String?
  city           String?
  addressLine    String?
  timezone       String           @default("UTC")
  currency       String           @default("USD")
  isActive       Boolean          @default(true)
  publicBookingEnabled Boolean    @default(false)
  bookingMode    VenueBookingMode @default(AUTO_CONFIRM)
  placementMode  VenuePlacementMode @default(AUTO_ASSIGN)
  minPartySize   Int              @default(1)
  maxOnlinePartySize Int          @default(12)
  minAdvanceNoticeMinutes Int     @default(120)
  maxDaysAhead   Int              @default(60)
  defaultReservationDurationMinutes Int @default(120)
  publicInstructions String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  areas         Area[]
  reservations  Reservation[]
  businessHours BusinessHours[]
  blackoutRules BlackoutRule[]
  tables        Table[]
  bookingEvents BookingEvent[]
  floorLayouts FloorLayout[]
  adminRoles    AdminRoleAssignment[]
  authInvites   AuthInvite[]
  menuCategories MenuCategory[]
  menuItems     MenuItem[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model BookingEvent {
  id          String   @id @default(cuid())
  venueId     String
  isActive    Boolean  @default(true)
  name        String
  eventType   BookingEventType
  singleDate  DateTime?
  dateStart   DateTime?
  dateEnd     DateTime?
  weekdays    Int[]    @default([])
  confirmationMode VenueBookingMode?
  placementMode VenuePlacementMode?
  minPartySize Int?
  maxOnlinePartySize Int?
  minAdvanceNoticeMinutes Int?
  maxDaysAhead Int?
  durationMinutes Int?
  publicInstructions String?
  publicLabel String?
  allowedAreaIds String[] @default([])
  allowedTableIds String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, isActive])
}

model Area {
  id        String   @id @default(cuid())
  venueId   String
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue  Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  tables Table[]
  floorLayoutAreas FloorLayoutArea[]

  @@unique([venueId, name])
  @@index([venueId])
}

model Table {
  id           String     @id @default(cuid())
  venueId      String
  areaId       String
  name         String
  code         String?
  shape        TableShape @default(SQUARE)
  tableType    TableType  @default(STANDARD)
  canCombine   Boolean    @default(false)
  combineGroup String?
  capacityMin  Int?
  capacityMax  Int
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  venue        Venue              @relation(fields: [venueId], references: [id], onDelete: Cascade)
  area         Area               @relation(fields: [areaId], references: [id], onDelete: Cascade)
  reservations ReservationTable[]
  blocks       TableBlock[]
  floorLayoutTables FloorLayoutTable[]

  @@unique([venueId, name])
  @@unique([venueId, code])
  @@index([venueId])
  @@index([areaId])
}

model TableBlock {
  id        String   @id @default(cuid())
  tableId   String
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  table Table @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId])
  @@index([startsAt, endsAt])
}

model Guest {
  id             String   @id @default(cuid())
  organizationId String
  firstName      String?
  lastName       String?
  fullName       String?
  email          String?
  phone          String?
  notes          String?
  tags           Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reservations  Reservation[]
  notifications NotificationLog[]

  @@index([organizationId])
  @@index([email])
  @@index([phone])
}

model ReservationStatus {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  label          String
  color          String?
  isDefault      Boolean  @default(false)
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Reservation {
  id                  String   @id @default(cuid())
  organizationId      String
  venueId             String
  guestId             String
  reservationStatusId String
  reservationDate     DateTime
  startAt             DateTime
  endAt               DateTime
  partySize           Int
  source              String?
  internalNotes       String?
  specialRequests     String?
  depositRequired     Boolean  @default(false)
  bookingStatus       BookingLifecycleStatus @default(PENDING)
  paymentStatus       PaymentStatus @default(UNPAID)
  createdByUserId     String?
  updatedByUserId     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  venue             Venue              @relation(fields: [venueId], references: [id], onDelete: Cascade)
  guest             Guest              @relation(fields: [guestId], references: [id], onDelete: Restrict)
  status            ReservationStatus  @relation(fields: [reservationStatusId], references: [id], onDelete: Restrict)
  createdByUser     User?              @relation("CreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser     User?              @relation("UpdatedByUser", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  reservationTables ReservationTable[]
  deposit           Deposit?
  notifications     NotificationLog[]

  @@index([organizationId])
  @@index([venueId, reservationDate])
  @@index([guestId])
  @@index([reservationStatusId])
  @@index([startAt, endAt])
  @@index([bookingStatus])
  @@index([paymentStatus])
}

model ReservationTable {
  id            String   @id @default(cuid())
  reservationId String
  tableId       String
  createdAt     DateTime @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  table       Table       @relation(fields: [tableId], references: [id], onDelete: Restrict)

  @@unique([reservationId, tableId])
  @@index([tableId])
}

model Deposit {
  id            String    @id @default(cuid())
  reservationId String    @unique
  amountMinor   Int
  currency      String    @default("USD")
  status        String
  paidAt        DateTime?
  provider      String?
  providerRef   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([status])
}

model User {
  id             String    @id @default(cuid())
  organizationId String?
  email          String    @unique
  firstName      String?
  lastName       String?
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  passwordHash   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization        Organization?         @relation("OrganizationUsers", fields: [organizationId], references: [id], onDelete: SetNull)
  memberships         Membership[]
  createdReservations Reservation[]         @relation("CreatedByUser")
  updatedReservations Reservation[]         @relation("UpdatedByUser")
  auditLogs           AuditLog[]            @relation("AuditActor")
  adminRoles          AdminRoleAssignment[]
  authSessions        AuthSession[]
  passwordResetTokens PasswordResetToken[]
  sentInvites         AuthInvite[]          @relation("AuthInviteSender")

  @@index([organizationId])
}

model Membership {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, role])
  @@index([organizationId])
  @@index([userId])
}

model AuditLog {
  id             String      @id @default(cuid())
  organizationId String?
  venueId        String?
  actorUserId    String?
  entityType     String
  entityId       String
  action         AuditAction
  changes        Json?
  metadata       Json?
  createdAt      DateTime    @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUser    User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([venueId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model BusinessHours {
  id        String   @id @default(cuid())
  venueId   String
  dayOfWeek Int
  openTime  String
  closeTime String
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, dayOfWeek])
  @@index([venueId])
}

model BlackoutRule {
  id        String   @id @default(cuid())
  venueId   String
  name      String
  startsAt  DateTime
  endsAt    DateTime
  isFullDay Boolean  @default(false)
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@index([startsAt, endsAt])
}

model AdminRoleAssignment {
  id             String    @id @default(cuid())
  userId         String
  role           AdminRole
  organizationId String?
  venueId        String?
  isActive       Boolean   @default(true)
  scopeKey       String    @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  venue        Venue?        @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([userId, role])
  @@index([organizationId])
  @@index([venueId])
}

model AuthInvite {
  id              String    @id @default(cuid())
  email           String
  tokenHash       String    @unique
  role            AdminRole
  organizationId  String?
  venueId         String?
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())

  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  venue         Venue?        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  invitedByUser User?         @relation("AuthInviteSender", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([expiresAt])
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model NotificationLog {
  id             String              @id @default(cuid())
  organizationId String
  reservationId  String?
  guestId        String?
  channel        NotificationChannel
  templateKey    String?
  recipient      String
  status         NotificationStatus  @default(QUEUED)
  provider       String?
  providerRef    String?
  errorMessage   String?
  sentAt         DateTime?
  createdAt      DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reservation  Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  guest        Guest?       @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([reservationId])
  @@index([guestId])
  @@index([status])
  @@index([createdAt])
}


model StripeEvent {
  id          String   @id
  processedAt DateTime @default(now())
}

model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

model MenuCategory {
  id        String   @id @default(cuid())
  venueId   String
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  items MenuItem[]

  @@unique([venueId, name])
  @@index([venueId])
}

model MenuItem {
  id          String   @id @default(cuid())
  venueId     String
  categoryId  String
  name        String
  description String?
  priceMinor  Int
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  venue    Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  category MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([venueId, name])
  @@index([venueId])
  @@index([categoryId])
}

model FloorLayout {
  id                    String            @id @default(cuid())
  venueId               String
  status                FloorLayoutStatus
  version               Int               @default(1)
  name                  String?
  canvasWidth           Int               @default(1600)
  canvasHeight          Int               @default(900)
  gridSize              Int               @default(24)
  isCurrent             Boolean           @default(true)
  publishedFromLayoutId String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  venue                 Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  publishedFromLayout   FloorLayout?      @relation("FloorLayoutPublishSource", fields: [publishedFromLayoutId], references: [id], onDelete: SetNull)
  publishChildren       FloorLayout[]     @relation("FloorLayoutPublishSource")
  areas                 FloorLayoutArea[]
  tables                FloorLayoutTable[]

  @@unique([venueId, status, version])
  @@index([venueId, status, isCurrent])
}

model FloorLayoutArea {
  id            String      @id @default(cuid())
  floorLayoutId String
  areaId        String?
  name          String
  sortOrder     Int         @default(0)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  floorLayout   FloorLayout @relation(fields: [floorLayoutId], references: [id], onDelete: Cascade)
  area          Area?       @relation(fields: [areaId], references: [id], onDelete: SetNull)
  tables        FloorLayoutTable[]

  @@index([floorLayoutId])
  @@index([areaId])
}

model FloorLayoutTable {
  id                String           @id @default(cuid())
  floorLayoutId     String
  floorLayoutAreaId String?
  tableId           String
  label             String
  capacityMin       Int?
  capacityMax       Int
  shape             TableShape       @default(SQUARE)
  x                 Int              @default(0)
  y                 Int              @default(0)
  width             Int              @default(96)
  height            Int              @default(96)
  rotation          Int              @default(0)
  isActive          Boolean          @default(true)
  combinableMeta    Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  floorLayout       FloorLayout      @relation(fields: [floorLayoutId], references: [id], onDelete: Cascade)
  floorLayoutArea   FloorLayoutArea? @relation(fields: [floorLayoutAreaId], references: [id], onDelete: SetNull)
  table             Table            @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([floorLayoutId, tableId])
  @@index([floorLayoutId])
  @@index([floorLayoutAreaId])
  @@index([tableId])
}
