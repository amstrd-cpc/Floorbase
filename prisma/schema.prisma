generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Initial placeholder model to validate PostgreSQL + Prisma integration.
/// This will be replaced by domain models in subsequent tasks.
model Healthcheck {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}
